<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Property_Agreement_Preparation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Property_Agreement_Preparation.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Property_Agreement_Preparation</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <style>
        footer {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
            margin-top: 60px;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-content {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 15px;
        }

            .footer-content a {
                color: rgba(255, 255, 255, 0.9);
                text-decoration: none;
                font-size: 14px;
                transition: color 0.3s ease;
            }

                .footer-content a:hover {
                    color: white;
                }

        .footer-divider {
            color: rgba(255, 255, 255, 0.3);
            margin: 0 15px;
        }

        .footer-copyright {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.8);
        }

        @@media (max-width: 768px) {
            .footer-content {
                flex-direction: column;
                gap: 15px;
            }

            .footer-divider {
                display: none;
            }
        }
    </style>

    <footer>
        <div class="footer-container">
            <div class="footer-content">
                <span class="footer-copyright">&copy; 2026 PropertyDoc</span>
                <span class="footer-divider">|</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <span class="footer-divider">|</span>
                <a href="https://support.syncfusion.com/support/tickets/create" target="_blank">Support</a>
            </div>
            <div class="footer-copyright">
                Property Agreement Preparation Tool
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
